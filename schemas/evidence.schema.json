{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "const": "evidence"
    },
    "schema_version": {
      "const": "1"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "customer"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "verification": {
            "enum": [
              "pending",
              "document",
              "lab",
              "customer"
            ]
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "scope",
          "classification",
          "title",
          "source_url",
          "section",
          "model",
          "release",
          "retrieved_at",
          "valid_until",
          "verification",
          "relative_path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "kind",
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
