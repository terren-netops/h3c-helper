{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "const": "network"
    },
    "schema_version": {
      "const": "1"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "combo_groups": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2
            },
            "minItems": 0
          },
          "poe_budget_w": {
            "type": "number",
            "minimum": 0
          },
          "poe_load_w": {
            "type": "number",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "poe_ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "port": {
                  "type": "string",
                  "minLength": 1
                },
                "load_w": {
                  "type": "number",
                  "minimum": 0
                },
                "limit_w": {
                  "type": "number",
                  "minimum": 0
                },
                "required_standard": {
                  "type": "string",
                  "minLength": 1
                },
                "supported_standards": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "port",
                "load_w",
                "limit_w",
                "required_standard",
                "supported_standards"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "poe_failure_budget_w": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "ports",
          "combo_groups",
          "poe_budget_w",
          "poe_load_w",
          "quantity"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "device",
              "port"
            ],
            "additionalProperties": false
          },
          "b": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "device",
              "port"
            ],
            "additionalProperties": false
          },
          "speed_gbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "forwarding_state": {
            "enum": [
              "forwarding",
              "blocked",
              "unknown"
            ]
          },
          "aggregation_group": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "a",
          "b",
          "speed_gbps"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "subnets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "vrf": {
            "type": "string",
            "minLength": 1
          },
          "cidr": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "vrf",
          "cidr"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "tax_basis": {
            "enum": [
              "inclusive",
              "exclusive"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "currency",
          "tax_basis",
          "quantity",
          "unit_price",
          "total",
          "source",
          "valid_until"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "resilience": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "string",
          "minLength": 1
        },
        "demands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "min_gbps": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "source",
              "destination",
              "min_gbps"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "remove_devices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "maxItems": 1000
              },
              "remove_links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "maxItems": 1000
              }
            },
            "required": [
              "id",
              "remove_devices",
              "remove_links"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "assumptions",
        "demands",
        "scenarios"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schema_version",
    "devices",
    "links",
    "subnets",
    "quotes"
  ],
  "additionalProperties": false
}
